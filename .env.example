# Azure DevOps Server (ALM)
# URL — база коллекции (БЕЗ проекта); проект задаётся отдельной переменной,
# т.к. репозитории могут лежать в разных проектах ALM.
AZURE_DEVOPS_URL=https://alm-itsk.gazprom-neft.local:8080/TFS/GPN
AZURE_DEVOPS_PROJECT=U200001871_mkhdbrd
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_REPO=U200001871_mkhdbrd_greenplum
AZURE_DEVOPS_API_VERSION=6.1-preview

# LLM (LiteLLM-шлюз)
LLM_URL=https://spb99akl-dgx02.gazprom-neft.local/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=qwen3:latest

# Постинг резюме комментарием в PR
POST_COMMENTS=false

# TLS: false — самоподписанные сертификаты на корпоративных хостах
VERIFY_SSL=false
