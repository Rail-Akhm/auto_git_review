# =====================================================================
# ПРИМЕР конфигурации для ноутбука auto_git_review_research.ipynb
#
# Все адреса и имена ниже — примеры. Реальные значения корпоративного
# контура задаются на сервере развёртывания (.env / Connections Airflow)
# и в этом материале не раскрываются.
#
# Для «живых» вызовов (разделы 2.4 и 8 ноутбука) скопируйте файл в .env,
# заполните секреты и запустите внутри корпоративной сети. Без .env
# ноутбук работает офлайн: инварианты H1–H4 выполняются, живые клетки
# выводят SKIP.
# =====================================================================

# --- Azure DevOps Server (on-prem ALM) ---
AZURE_DEVOPS_URL=https://alm.example.local:8080/TFS/ExampleCollection   # база КОЛЛЕКЦИИ, без проекта
AZURE_DEVOPS_PROJECT=ExampleProject1
AZURE_DEVOPS_REPO=example_repo_greenplum
AZURE_DEVOPS_API_VERSION=6.1-preview
# PAT с правами «чтение» (ноутбук ничего не пишет в ALM)
AZURE_DEVOPS_PAT=

# --- LLM (LiteLLM-шлюз, OpenAI-совместимый) ---
LLM_URL=https://llm.example.local/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=qwen3:latest

# --- Прочее ---
# false — не проверять TLS (самоподписанные корпоративные сертификаты)
VERIFY_SSL=false
# Ноутбук никогда не включает постинг комментариев в PR
POST_COMMENTS=false
